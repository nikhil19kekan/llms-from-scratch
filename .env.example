# Copy this file to `.env` and fill in the key(s) for the provider(s) you use.
# You only need the key for whichever model you set in LLM_MODEL.

# Which model to talk to. Format is "provider/model".
# Examples:
#   openai/gpt-4o
#   gemini/gemini-2.0-flash
LLM_MODEL=

# Provider API keys (fill in only the ones you need)
OPENAI_API_KEY=
GEMINI_API_KEY=

# JEV (OpenRouter) decisions endpoint
JEV_API_KEY=
